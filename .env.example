# YGMotion Studio V3 - Environment Configuration
# Copy this file to .env and fill in your keys (optional features)

# ElevenLabs API Key (For voiceover & Sound FX synthesis)
# Optional: If omitted, local mock synthesis/preview is used
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# D-ID Studio API Key (For animated talking-head / avatar loops)
# Optional
DID_API_KEY=your_did_api_key_here

# Pexels API Key (For automated B-roll stock footage download)
# Optional
PEXELS_API_KEY=your_pexels_api_key_here

# Ollama Host (For local offline LLM script generation)
# Default is http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
